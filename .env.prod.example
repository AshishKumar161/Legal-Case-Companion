# ==============================================================================
# Legal Case Companion (LCC) — Production Environment Template
# ==============================================================================
# Classification:
# [SERVER-ONLY]     : Backend runtime secrets (NEVER expose to browser/frontend)
# [DEPLOYMENT-ONLY] : Used strictly by infrastructure orchestrators / CI-CD
# [FRONTEND-PUBLIC] : Prefixed with NEXT_PUBLIC_ for browser consumption
# ==============================================================================

# --- Application Core ---
PROJECT_NAME="Legal Case Companion"
ENVIRONMENT="production"                               # [SERVER-ONLY] Set explicitly to production
DEBUG=false                                            # [SERVER-ONLY] Must remain false in production
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"                                       # [SERVER-ONLY] INFO | WARNING | ERROR
FRONTEND_URL="https://app.legalcasecompanion.in"       # [SERVER-ONLY] Primary client application URL
BACKEND_CORS_ORIGINS='["https://app.legalcasecompanion.in"]' # [SERVER-ONLY] Strict production origin

# --- Database & Connection Pooling ---
# [SERVER-ONLY] PostgreSQL 15+ URI (managed RDS/Aurora with psycopg)
DATABASE_URL="postgresql+psycopg://lcc_prod_user:YOUR_STRONG_PROD_DB_PASSWORD@prod-db.internal:5432/legal_db"
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=15000

# --- Redis & Shared Presence ---
# [SERVER-ONLY] Managed Redis 7+ cluster/instance
REDIS_URL="redis://:YOUR_STRONG_REDIS_AUTH@prod-redis.internal:6379/0"
REDIS_KEY_PREFIX="lcc_prod"
PRESENCE_TTL_SECONDS=45
PRESENCE_HEARTBEAT_INTERVAL_SECONDS=15
INSTANT_CALL_RING_TIMEOUT_SECONDS=60

# --- Authentication & Cryptographic Keys (Ed25519) ---
# [SERVER-ONLY] High-entropy Ed25519 PKCS8 PEM strings
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_ED25519_PRIVATE_KEY\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_ED25519_PUBLIC_KEY\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_INACTIVITY_DAYS=7
CSRF_SECRET_KEY="YOUR_64_CHAR_HEX_RANDOM_CSRF_SECRET"
EMAIL_CHECK_DELIVERABILITY=true

# --- Commercial & Taxation Policies (India GST SAC 9982) ---
COMMERCIAL_PLATFORM_FEE_PERCENT=10.0
COMMERCIAL_GST_PERCENT=18.0

# --- Private Document Storage (AWS S3 / Cloudian) ---
AWS_S3_BUCKET_NAME="lcc-prod-secure-documents"
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="YOUR_IAM_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_IAM_SECRET_KEY"
AWS_WEBHOOK_SECRET="YOUR_TRUSTED_HMAC_WEBHOOK_SECRET"

# --- Antivirus / Malware Scanner (ClamAV Daemon) ---
CLAMAV_HOST="clamav.internal"
CLAMAV_PORT=3310

# --- WebRTC / NAT Traversal (Coturn Relay) ---
TURN_SERVER_URL="turn:turn.legalcasecompanion.in:3478"
TURN_USERNAME="lcc_turn_user"
TURN_CREDENTIAL="YOUR_COTURN_AUTH_SECRET"

# --- Payments Gateway (Razorpay / Stripe) ---
STRIPE_API_KEY="sk_live_YOUR_LIVE_PAYMENT_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_LIVE_WEBHOOK_SECRET"

# --- Email Notifications (Production SendGrid / SES) ---
EMAIL_PROVIDER="sendgrid"                              # smtp | sendgrid | ses
EMAIL_FROM="notifications@legalcasecompanion.in"
SENDGRID_API_KEY="SG.YOUR_SENDGRID_API_KEY"

# --- Single Sign-On (Google OAuth 2.0 / OIDC) ---
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="https://app.legalcasecompanion.in/auth/callback"

# --- AI & Document Intelligence ---
OPENAI_API_KEY="sk-proj-YOUR_PROD_OPENAI_KEY"
EMBEDDING_MODEL="text-embedding-3-small"

# --- Video Recording & LiveKit SFU ---
LOCAL_RECORDING_STORAGE_DIR="/var/lcc/storage/recordings"
LIVEKIT_URL="https://livekit.legalcasecompanion.in"
LIVEKIT_API_KEY="YOUR_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="YOUR_LIVEKIT_API_SECRET"
