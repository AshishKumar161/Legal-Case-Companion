# ==============================================================================
# Legal Case Companion (LCC) — Production & Environment Variables Template
# ==============================================================================
# Classification:
# [SERVER-ONLY]     : Backend runtime secrets (NEVER expose to browser/frontend)
# [DEPLOYMENT-ONLY] : Used strictly by infrastructure orchestrators / CI-CD
# [FRONTEND-PUBLIC] : Prefixed with NEXT_PUBLIC_ for browser consumption
# ==============================================================================

# --- Application Core ---
PROJECT_NAME="Legal Case Companion"
ENVIRONMENT="development"                              # [SERVER-ONLY] development | test | production
DEBUG=false                                            # [SERVER-ONLY] true in dev, false in prod
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"                                       # [SERVER-ONLY] DEBUG | INFO | WARNING | ERROR
FRONTEND_URL="http://localhost:3000"                  # [SERVER-ONLY] Primary client application URL
BACKEND_CORS_ORIGINS='["http://localhost:3000","https://app.legalcasecompanion.in"]' # [SERVER-ONLY]

# --- Database & Connection Pooling ---
# [SERVER-ONLY] PostgreSQL 15+ URI (with psycopg driver in production)
DATABASE_URL="postgresql+psycopg://lcc_admin:ChangeMeStrongPassword!@localhost:5432/legal_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000

# --- Authentication & Cryptographic Keys (Ed25519) ---
# [SERVER-ONLY] Generate with:
# python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; k=Ed25519PrivateKey.generate(); print(k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode()); print(k.public_key().public_bytes(serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo).decode())"
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_INACTIVITY_DAYS=7
CSRF_SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string" # [SERVER-ONLY] Required in production

# --- Private Document Storage (AWS S3) ---
# [SERVER-ONLY] Private bucket with ServerSideEncryption=AES256
AWS_S3_BUCKET_NAME="lcc-secure-documents"
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="AKIA_SAMPLE_KEY_FOR_S3"
AWS_SECRET_ACCESS_KEY="SAMPLE_SECRET_KEY_FOR_S3"
AWS_WEBHOOK_SECRET="replace-with-trusted-hmac-secret-for-malware-callbacks" # [SERVER-ONLY]

# --- Antivirus / Malware Scanner (ClamAV Daemon) ---
# [SERVER-ONLY] ClamD TCP daemon host & port (fails closed if configured and unreachable)
CLAMAV_HOST="localhost"
CLAMAV_PORT=3310

# --- WebRTC / NAT Traversal (Coturn Relay) ---
# [SERVER-ONLY] Dynamic / Static TURN server credentials
TURN_SERVER_URL="turn:turn.legalcasecompanion.in:3478"
TURN_USERNAME="lcc_turn_user"
TURN_CREDENTIAL="CHANGE_ME_COTURN_STATIC_AUTH_SECRET"

# --- Payments Gateway (Stripe) ---
# [SERVER-ONLY] Backend authoritative API key and webhook HMAC signing secret
STRIPE_API_KEY="sk_test_replace_with_live_or_test_stripe_secret"
STRIPE_WEBHOOK_SECRET="whsec_replace_with_stripe_endpoint_secret"

# --- Email Notifications ---
EMAIL_PROVIDER="console"                               # [SERVER-ONLY] console | smtp | sendgrid | ses
EMAIL_FROM="noreply@legalcasecompanion.in"
# SendGrid (if EMAIL_PROVIDER="sendgrid")
SENDGRID_API_KEY="SG.replace_with_sendgrid_key"
# SMTP (if EMAIL_PROVIDER="smtp")
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USERNAME="postmaster@legalcasecompanion.in"
SMTP_PASSWORD="replace_with_smtp_password"
SMTP_TLS=true

# --- Single Sign-On (Google OAuth 2.0 / OIDC) ---
GOOGLE_OAUTH_ENABLED=false                             # [SERVER-ONLY]
GOOGLE_CLIENT_ID="replace_with_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace_with_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"

# --- Existing AI Provider (OpenAI) ---
# [SERVER-ONLY] Subsystem remains stable; key required for existing RAG & embedding retrieval
OPENAI_API_KEY="sk-proj-replace_with_openai_key"
EMBEDDING_MODEL="text-embedding-3-small"

# --- Video Recording & LiveKit SFU ---
# [SERVER-ONLY] Directory for private, encrypted consultation recordings
LOCAL_RECORDING_STORAGE_DIR="storage/recordings"
# [SERVER-ONLY] Optional LiveKit SFU for multi-party escalation (defaults to native P2P mesh WebRTC)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

