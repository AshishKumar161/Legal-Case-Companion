{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "API Health, Traffic & Latency SLOs",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisLabel": "req/sec", "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "title": "Request Throughput by Endpoint",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (path) (rate(lcc_http_requests_total[2m]))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "title": "HTTP Status Distribution",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status) (rate(lcc_http_status_total[2m]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "drawStyle": "line" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 300 },
              { "color": "red", "value": 500 }
            ]
          },
          "unit": "ms"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "title": "Latency Percentiles (P50, P90, P95, P99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "lcc_http_latency_ms{quantile=\"0.5\"}",
          "legendFormat": "P50 Latency"
        },
        {
          "expr": "lcc_http_latency_ms{quantile=\"0.9\"}",
          "legendFormat": "P90 Latency"
        },
        {
          "expr": "lcc_http_latency_ms{quantile=\"0.95\"}",
          "legendFormat": "P95 Latency (SLO: 500ms)"
        },
        {
          "expr": "lcc_http_latency_ms{quantile=\"0.99\"}",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 5,
      "title": "Security, Isolation & Threat Monitoring",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "id": 6,
      "title": "Authentication Failures by Reason",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (reason) (increase(lcc_auth_failures_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "id": 7,
      "title": "Authorization & BOLA Denials",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (resource) (increase(lcc_authorization_denials_total[5m]))",
          "legendFormat": "{{resource}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "id": 8,
      "title": "Cryptographic Tamper Violations",
      "type": "stat",
      "targets": [
        {
          "expr": "lcc_tamper_events_total",
          "legendFormat": "Tamper Events"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 9,
      "title": "Worker Jobs, AI & Outbox Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "id": 10,
      "title": "Background Worker Processing by Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (job_type, status) (rate(lcc_queue_jobs_total[5m]))",
          "legendFormat": "{{job_type}} - {{status}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "id": 11,
      "title": "Transactional Outbox Events",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (event_type, status) (rate(lcc_outbox_events_total[5m]))",
          "legendFormat": "{{event_type}} ({{status}})"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["lcc", "production", "sre"],
  "time": { "from": "now-3h", "to": "now" },
  "title": "Legal Case Companion — SRE Platform Dashboard",
  "uid": "lcc-platform-sre-prod",
  "version": 1
}
